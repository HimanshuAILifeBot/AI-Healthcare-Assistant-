OPENAI_API_KEY=your_openai_api_key_here

DB_HOST=localhost
DB_PORT=5432
DB_USER=fastapi_user
DB_PASSWORD=yourpassword
DB_NAME=healthcare
# ...existing code...

# Neon Database Configuration (Recommended - Serverless PostgreSQL)
# Get your connection string from: https://neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
NEON_DATABASE_URL=postgresql://your_user:your_password@ep-xxx.neon.tech/your_database?sslmode=require

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:5173

# ElevenLabs API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region
# AZURE_SPEECH_HOST=https://your-region.api.cognitive.microsoft.com/

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
OPENAI_API_VERSION=2024-12-01-preview
# Available deployments: gpt-4, gpt-4o, gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT=gpt-4o



